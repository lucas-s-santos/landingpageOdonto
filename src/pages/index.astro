---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Abertura from '../components/Abertura.astro';
import ComoAtendemos from '../components/ComoAtendemos.astro';
import Anatomia from '../components/Anatomia.astro';
import Tratamentos from '../components/Tratamentos.astro';
import TexturaEsmalte from '../components/TexturaEsmalte.astro';
import QuemAtende from '../components/QuemAtende.astro';
import Estrutura from '../components/Estrutura.astro';
import PrimeiraConsulta from '../components/PrimeiraConsulta.astro';
import Agendar from '../components/Agendar.astro';
import Rodape from '../components/Rodape.astro';
import BarraFixa from '../components/BarraFixa.astro';
import Entrada from '../components/Entrada.astro';
import Fecho from '../components/Fecho.astro';
import { CLINICA, EH_DEMO } from '../data/conteudo';

/**
 * PASSO 3 — estrutura semântica com copy real, ainda sem movimento.
 *
 * A ordem das seções é a ordem da objeção que cada uma vence (BRIEF seção 4).
 * Não reordenar sem reler aquela tabela: a seção 7 vem depois da 6 porque
 * ninguém se importa com o roteiro da consulta antes de confiar no lugar.
 *
 * NÃO IMPORTAR AQUI, ainda: Three.js. É o passo 5, e entra por import()
 * dinâmico quando a seção do dente aparece — nunca no bundle inicial.
 */
---

<Base
  titulo={`${CLINICA.nome} — dentista em ${CLINICA.cidade}`}
  descricao="Avaliação odontológica com explicação do que foi encontrado, por escrito. Atendimento em [PREENCHER cidade]."
>
  {/* A vinheta de entrada: só na demo. Ver Entrada.astro. */}
  {EH_DEMO && <Entrada />}
  {/*
    A PÁGINA é uma folha opaca por cima do Fecho. No fim da rolagem ela sobe
    e descobre a faixa que estava parada embaixo — ver Fecho.astro. Sem o
    Fecho (fora da demo), o invólucro não muda nada.
  */}
  <div class="pagina">
  <Cabecalho />

  <main id="conteudo">
    <Abertura />
    <ComoAtendemos />
    <Anatomia />
    <Tratamentos />
    <TexturaEsmalte />
    <QuemAtende />
    <Estrutura />
    <PrimeiraConsulta />
    <Agendar />
  </main>

  <Rodape />
  <BarraFixa />
  </div>

  {EH_DEMO && <Fecho />}
</Base>

<script>
  // PASSO 4 — camada de movimento.
  //
  // A página inteira funciona sem ela: tudo nasce visível no HTML, a
  // abertura anima em CSS e o accordion abre e fecha por conta do <details>.
  //
  // O módulo em si é pequeno e sem biblioteca. Ele é que decide adiar o
  // pedaço caro (GSAP, ScrollTrigger, Lenis) e só no desktop.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    import('../scripts/movimento');
  }
</script>
