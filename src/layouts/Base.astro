---
import '../styles/tokens.css';
import { ABERTURA, CLINICA, DIA_SCHEMA, EH_DEMO, EXPEDIENTE, PERGUNTAS } from '../data/conteudo';

interface Props {
  titulo: string;
  descricao: string;
  /**
   * Emite o JSON-LD FAQPage nesta página.
   *
   * Opcional e desligado por padrão de propósito: a marcação de FAQ vale
   * para a página onde as perguntas estão VISÍVEIS na tela. Emitir em todas
   * as rotas marcaria como pergunta respondida um texto que ali não existe,
   * que é o erro clássico desse tipo de marcação — e ainda repetiria a
   * mesma entidade em duas URLs.
   */
  faq?: boolean;
}

const { titulo, descricao, faq = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * Campo não preenchido não vai para o Google.
 *
 * Antes, no modo cliente, o JSON-LD publicava a string literal
 * "[PREENCHER nome da clínica]" como se fosse o nome do estabelecimento.
 * Campo ausente é ruim; campo presente com lixo dentro é pior, porque o
 * buscador acredita. Some com o que não estiver preenchido — e o
 * "npm run conformidade" continua acusando o [PREENCHER] no HTML visível,
 * que é onde ele tem que aparecer.
 */
const preenchido = (v: unknown): v is string =>
  typeof v === 'string' && v.trim() !== '' && !v.includes('[PREENCHER');

const limpar = (obj: Record<string, unknown>): Record<string, unknown> =>
  Object.fromEntries(
    Object.entries(obj).filter(([, v]) => {
      if (typeof v === 'string') return preenchido(v);
      if (Array.isArray(v)) return v.length > 0;
      return v != null;
    })
  );

/**
 * JSON-LD Dentist.
 *
 * "openingHoursSpecification" no lugar de "openingHours". O campo antigo
 * recebia a FRASE do rodapé ("Segunda a sexta, das 8h às 19h."), e o
 * schema.org espera "Mo-Fr 08:00-19:00" — o Google descartava o campo
 * inteiro. Resultado: o horário estava escrito na página e invisível para a
 * busca, justamente o dado que o painel local mostra a quem procura
 * dentista à noite. A forma com dayOfWeek/opens/closes é explícita e não
 * depende de o parser entender abreviação.
 */
const jsonLd = limpar({
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: CLINICA.nome,
  url: canonical.origin,
  telephone: CLINICA.telefone,
  address: limpar({
    '@type': 'PostalAddress',
    streetAddress: CLINICA.endereco,
    addressLocality: CLINICA.cidade,
    addressRegion: CLINICA.uf,
    postalCode: CLINICA.cep,
    addressCountry: 'BR',
  }),
  openingHoursSpecification: EXPEDIENTE.map((faixa) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: faixa.dias.map((d) => DIA_SCHEMA[d]),
    opens: faixa.abre,
    closes: faixa.fecha,
  })),
  // O perfil no Google é o único lugar onde as avaliações moram. Declarar o
  // vínculo ajuda o buscador a ligar site e ficha; republicar as avaliações
  // aqui seria infração da CFO-196 (BRIEF seção 3).
  sameAs: preenchido(CLINICA.perfilGoogle) ? [CLINICA.perfilGoogle] : [],
  areaServed: CLINICA.cidade,
});

/**
 * FAQPage a partir da seção 7, que já é pergunta e resposta honesta.
 *
 * Sem promessa de resultado rico: em 2023 o Google restringiu os resultados
 * ricos de FAQ a sites de governo e de saúde reconhecidos, e uma clínica de
 * bairro provavelmente não entra nesse recorte. O que a marcação garante é
 * outra coisa — que o buscador leia a página como perguntas respondidas em
 * vez de um bloco de texto, e custa zero.
 *
 * As respostas saem do mesmo conteudo.ts da página visível, então copy e
 * marcação não têm como divergir.
 */
const faqLd = faq && PERGUNTAS.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: PERGUNTAS.map((p) => ({
        '@type': 'Question',
        name: p.pergunta,
        acceptedAnswer: { '@type': 'Answer', text: p.resposta },
      })),
    }
  : null;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#efede6" />

    {/*
      A demo não pode ser indexada. Ela usa uma cidade real, uma praça real e
      um nome de clínica que não existe — se o Google a indexar, ela passa a
      competir por buscas de Alfenas e a confundir quem procura dentista lá.
      Sai sozinho quando MODO vira 'cliente'.
    */}
    {EH_DEMO && <meta name="robots" content="noindex, nofollow" />}

    {/* Só o display entra em preload: é a fonte do LCP. Pré-carregar as
        quatro competiria com o vídeo da abertura pela banda inicial. */}
    <link
      rel="preload"
      href="/fonts/CabinetGrotesk-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Gerados por `npm run og` a partir do conteudo.ts. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />

    {/*
      A prévia do link. É assim que a página chega a quem ainda não entrou
      nela: colada pela recepção no WhatsApp, na bio do Instagram, no status.
      Sem `og:image` o link chegava como um retângulo cinza. URL absoluta
      porque o WhatsApp não resolve caminho relativo.
    */}
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${CLINICA.nome}. ${ABERTURA.titulo}`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    {/*
      `JSON.stringify` não escapa `</script>`. Se algum campo de CLINICA
      contiver essa sequência, o bloco fecha cedo e o resto vira HTML
      executável. Hoje os campos são [PREENCHER] escritos por nós, mas quem
      vai preencher é outra pessoa colando nome, endereço e link do cliente.
      Escapar `<` custa uma linha e fecha a classe de bug inteira.
    */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
    />

    {
      faqLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(faqLd).replace(/</g, '\\u003c')}
        />
      )
    }

    <slot name="head" />
  </head>

  <body>
    <a href="#conteudo" class="pular-para-conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>

<style>
  /* Fica fora da tela até receber foco. Primeira parada do Tab na página. */
  .pular-para-conteudo {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--color-tinta);
    color: var(--color-osso);
    padding: 0.75rem 1.25rem;
    text-decoration: none;
  }

  .pular-para-conteudo:focus {
    left: 0;
  }
</style>
