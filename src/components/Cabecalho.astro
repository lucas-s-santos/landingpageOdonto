---
import { CLINICA, CTA } from '../data/conteudo';

interface Props {
  /**
   * Destino do CTA do cabeçalho.
   *
   * O padrão é a âncora da própria página, que é o caso da home. Existe
   * porque fora dela a âncora não existe: em /primeira-consulta o botão
   * apontava para um #agendar inexistente e simplesmente não fazia nada ao
   * ser clicado — pior que não ter botão, porque parece que funciona.
   */
  destinoCta?: string;
}

const { destinoCta = '#agendar' } = Astro.props;
---

<!-- Header estático, não fixo. Sem fundo próprio, sem borda: ele é parte da
     folha, não uma barra por cima dela. O CTA aqui é o MESMO CTA da página —
     mesmo verbo, mesma cor, mesmo destino. Não é CTA secundário. -->
<header class="grade items-baseline pt-8 pb-4">
  <p class="col-span-8 font-display text-tratamento font-medium sm:col-span-6">
    {CLINICA.nome}
  </p>

  <p class="col-span-4 justify-self-end sm:col-span-6">
    <a href={destinoCta} class="cta cta--vazado">{CTA}</a>
  </p>
</header>
