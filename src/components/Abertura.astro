---
import { ABERTURA, CTA } from '../data/conteudo';
---

<!-- SEÇÃO 1 — vence "é clínica séria ou é fundo de quintal?"
     Assimétrica: 60% de texto à esquerda, vídeo sangrando pela direita.
     No mobile o vídeo vai ACIMA do título, nunca atrás: sobrepor texto a
     720p em movimento em 390px abre mão do contraste AA. -->
<section class="abertura" aria-labelledby="abertura-titulo">
  <div class="abertura__video">
    <video
      data-video
      class="video-calibrado"
      poster="/video/hero-molar-poster.jpg"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/video/hero-molar-loop.webm" type="video/webm" />
      <source src="/video/hero-molar-loop.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="abertura__texto">
    <h1 id="abertura-titulo" class="text-abertura">
      {
        ABERTURA.tituloLinhas.map((linha) => (
          <span class="linha">
            <span>{linha}</span>
          </span>
        ))
      }
    </h1>
    <p class="abertura__apoio max-w-corpo mt-8">{ABERTURA.apoio}</p>
    <p class="mt-10">
      <a href="#agendar" class="cta" data-ima>{CTA}</a>
    </p>
  </div>
</section>

<style>
  .abertura {
    display: grid;
    gap: 2rem;
    padding-inline: var(--spacing-margem);
    padding-block: 2rem 0;
  }

  /* O `scale(1.06)` da animação de entrada empurra o vídeo ~22px para fora
     da largura durante 1,6 s, e sem recorte isso vira uma barra de rolagem
     horizontal piscando no carregamento. O contêiner corta; o zoom continua
     igual. */
  .abertura__video {
    overflow: hidden;
  }

  .abertura__video video {
    width: 100%;
    height: clamp(220px, 42vh, 340px);
    object-fit: cover;
  }

  /* Cada linha do título é um bloco próprio. No mobile ela ainda pode
     quebrar sozinha se não couber — o que está fixo é onde a linha começa,
     não uma promessa de caber em uma tira só. */
  .abertura__texto h1 .linha {
    display: block;
    /* a máscara vive no CSS, não é mais adicionada por JS */
    overflow: hidden;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  /* --- a abertura anima em CSS, não em GSAP ---------------------------
     Esta é a única animação automática do primeiro paint, e ela é
     predeterminada: ninguém interage com ela. Animação CSS roda fora da
     main thread e continua suave enquanto o navegador ainda está baixando
     e compilando o resto.
     Fazer isso em GSAP custava 5,2 s de bootup e 912 ms numa única tarefa
     longa no perfil mobile do Lighthouse — medido, não suposto. */
  @media (prefers-reduced-motion: no-preference) {
    .abertura__texto h1 .linha > span {
      display: block;
      animation: subir 0.9s var(--ease-saida) both;
    }

    .abertura__texto h1 .linha:nth-child(1) > span {
      animation-delay: 0.2s;
    }
    .abertura__texto h1 .linha:nth-child(2) > span {
      animation-delay: 0.29s;
    }
    .abertura__texto h1 .linha:nth-child(3) > span {
      animation-delay: 0.38s;
    }

    .abertura__video video {
      animation: aproximar 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .abertura__apoio {
      animation: aparecer 0.5s var(--ease-saida) 0.7s both;
    }

    .abertura .cta {
      animation: assentar 0.5s var(--ease-saida) 0.9s both;
    }
  }

  @keyframes subir {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes aproximar {
    from {
      transform: scale(1.06);
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  @keyframes assentar {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (min-width: 900px) {
    .abertura {
      grid-template-columns: minmax(0, 63fr) minmax(0, 37fr);
      align-items: center;
      gap: 0;
      padding-right: 0; /* o vídeo sangra pela direita */
      padding-block: 3rem 0;
    }

    .abertura__video {
      /* O vídeo não fica confinado na coluna 2: ele começa antes e passa
         POR BAIXO do texto. O bloco de texto continua ocupando os 60% da
         esquerda que o BRIEF pede — o que muda é onde o vídeo nasce.
         É isso que dá invasão de verdade em vez de dois blocos encostados. */
      grid-column: 1 / -1;
      grid-row: 1;
      margin-left: 46%;
    }

    .abertura__video video {
      height: 78vh;
      max-height: 720px;

      /* A borda esquerda do vídeo se dissolve no fundo da página. É isso que
         permite o título invadir sem perder contraste: onde o texto passa por
         cima, o vídeo já está quase todo em --osso.
         Preferido a uma caixa sólida atrás de cada linha, que obrigaria a
         afrouxar a entrelinha de 0.98 e mataria o aperto do display. */
      -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 40%);
      mask-image: linear-gradient(to right, transparent 0%, #000 40%);
    }

    .abertura__texto {
      grid-column: 1;
      grid-row: 1;
      z-index: 1;
      /* O texto fica nos 60% da esquerda, como o BRIEF pede. Quem invade
         quem: o vídeo nasce em 46% e passa por baixo; o título termina
         dentro da faixa dissolvida da máscara. Medido: o pior fundo sob a
         primeira linha dá mais de 9:1 contra --tinta. */
      margin-right: 0;
    }

    .abertura__texto h1 {
      /* Sem balance: as linhas são definidas na copy, não pelo navegador.
         O valor é `wrap`, não `normal` — `normal` não existe em text-wrap e
         a declaração inteira seria descartada, deixando o balance de pé. */
      text-wrap: wrap;
    }

    .abertura__apoio {
      /* o parágrafo de apoio NÃO invade: ele é texto pequeno e precisa dos
         13,6:1 inteiros. Só o display, que é grande, entra na zona do vídeo. */
      max-width: 46ch;
    }
  }
</style>
