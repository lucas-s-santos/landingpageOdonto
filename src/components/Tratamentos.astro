---
import { Picture } from 'astro:assets';
import { TRATAMENTOS } from '../data/conteudo';
import { imagemFlow } from '../data/imagens';
---

{/*
  SEÇÃO 4 — vence "vocês fazem o que eu preciso?"
  Não são cards: são linhas horizontais separadas por fio de 1px, densas,
  encostadas umas nas outras.

  Usa <details>/<summary> em vez de <button aria-expanded>. O MOTION.md pede
  button + aria-expanded, mas <summary> É um botão para o navegador e já expõe
  aria-expanded sozinho — com a vantagem de funcionar sem uma linha de
  JavaScript. Como o passo 3 não pode depender de JS, esta é a base honesta.
  O passo 4 anima interceptando o evento `toggle` e animando a altura do
  wrapper interno, sem trocar a marcação.
*/}
<section id="tratamentos" class="grade mt-r-colapso" aria-labelledby="tratamentos-titulo">
  <div class="col-span-full">
    <h2 id="tratamentos-titulo" class="text-secao">O que a gente faz</h2>
    <p class="max-w-corpo text-rotulo mt-4 opacity-75">
      Duração é estimativa de tempo de cadeira, não promessa de resultado. Cada caso muda.
    </p>
  </div>

  <div class="col-span-full mt-10">
    {
      TRATAMENTOS.map((t) => (
        <details id={`tratamento-${t.id}`} class="item" name="tratamentos">
          <summary class="item__cabeca">
            <span class="item__nome text-tratamento">{t.nome}</span>
            <span class="item__duracao text-rotulo">{t.duracao}</span>
            <span class="item__sinal" aria-hidden="true" />
          </summary>
          <div class="item__corpo">
            {/*
              A seção 5 do BRIEF pede "expande revelando texto e imagem", e
              até o lote 2 de imagens expandia só texto. São material e
              modelo didático — sem boca, sem procedimento, sem antes e
              depois (CFO-196).

              `loading="lazy"` dentro de um <details> fechado não baixa
              nada: conteúdo fechado não é renderizado. A imagem só chega
              quando a pessoa abre o item. A altura já fica reservada pelo
              width/height que o <Picture> escreve, então a animação do
              accordion mede o tamanho certo antes de a imagem carregar.
            */}
            <Picture
              class="item__imagem"
              src={imagemFlow(t.imagem)}
              alt={t.alt}
              widths={[400, 640, 960, 1200]}
              sizes="(min-width: 768px) 30vw, calc(100vw - 40px)"
              formats={['avif', 'webp']}
              loading="lazy"
              decoding="async"
            />
            <p class="item__texto max-w-corpo">{t.texto}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .item {
    border-top: 1px solid var(--color-linha);
  }

  .item:last-of-type {
    border-bottom: 1px solid var(--color-linha);
  }

  .item__cabeca {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.35rem;
    cursor: pointer;
    list-style: none;
    /* alvo de toque confortável no mobile */
    min-height: 56px;
    /* A transição do hover mora em tokens.css. Havia aqui um
       `transition: padding-left 0.001ms` deixado como marcador no passo 3;
       como estilo de componente vence a camada base, ele ANULAVA o deslize
       de 12px e o hover saltava. Encontrado pelo detector da impeccable. */
  }

  .item__cabeca::-webkit-details-marker {
    display: none;
  }

  .item__nome {
    flex: 1;
    font-family: var(--font-texto);
    font-weight: 500;
  }

  .item__duracao {
    flex: none;
    opacity: 0.7;
    display: none;
  }

  @media (min-width: 640px) {
    .item__duracao {
      display: block;
    }
  }

  /* Sinal de mais/menos desenhado em CSS. Nada de ícone de biblioteca e
     nada de seta — itens 7 e 14 da seção 9 do BRIEF. */
  .item__sinal {
    flex: none;
    position: relative;
    width: 14px;
    height: 14px;
    align-self: center;
  }

  .item__sinal::before,
  .item__sinal::after {
    content: '';
    position: absolute;
    background: var(--color-tinta);
    inset-inline: 0;
    top: 50%;
    height: 1px;
    margin-top: -0.5px;
  }

  .item__sinal::after {
    transform: rotate(90deg);
  }

  .item[open] .item__sinal::after {
    transform: rotate(0deg);
  }

  .item__corpo {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1.6rem;
  }

  .item__corpo :global(.item__imagem) {
    width: 100%;
    max-width: 30rem;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  /* No desktop a imagem fica à esquerda e o texto ao lado, os dois
     começando na mesma linha. Lado a lado a expansão cresce menos, e o
     parágrafo não desce para baixo da dobra quando o item abre. */
  @media (min-width: 768px) {
    .item__corpo {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: var(--spacing-gutter);
      align-items: start;
      padding-top: 0.25rem;
    }
  }
</style>
