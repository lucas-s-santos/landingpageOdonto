---
import { ASSINATURA_SEM_FIO, FIO_DA_MARCA as F } from '../data/marca';

const pct = (n: number) => `${n.toFixed(3)}%`;
---

{/*
  O ENCERRAMENTO — o fim da página, só na demo. (As classes não se chamam
  "fecho" porque a frase de fecho da seção 2 já usa esse nome.)

  A página inteira é uma folha opaca (`.pagina`, em index.astro) por cima
  desta faixa. A faixa fica PARADA no pé da janela (`position: sticky;
  bottom: 0`, embaixo da folha) e, no fim da rolagem, a folha sobe e a
  descobre — o rodapé aparece por baixo da página, como uma prancha que se
  levanta da mesa.

  Enquanto é descoberta, a marca se monta: as letras sobem uma depois da
  outra, o ponto acende e o fio corre dele até a borda da janela — o fio da
  prancha da seção 3, encerrando a página.

  A linha do tempo é a ROLAGEM DA PÁGINA INTEIRA, no trecho final: do
  instante em que falta uma altura de faixa para o fim (`100% - altura`) até
  o fim (`100%`). Presa à rolagem, não disparada por ela (MOTION.md §11):
  quem para, para a marca no meio; quem volta, desmonta.

  A primeira versão animava o fecho ao ENTRAR na tela, em ~300px de rolagem
  bem no fim. Passava rápido demais para ser notada — "não vi nada". Aqui a
  revelação ocupa uma altura de janela inteira.

  Sem movimento (reduced-motion): a faixa é um bloco comum no fim da página,
  com a marca inteira. Sem suporte a animação por rolagem (Firefox): a
  revelação por baixo continua (é só `sticky`), e a marca já vem inteira.
*/}
<div class="encerramento" style={`--proporcao: ${F.proporcao.toFixed(4)};`}>
  <div class="encerramento__conteudo">
    <div class="encerramento__marca" aria-hidden="true">
      <span class="encerramento__palavra" set:html={ASSINATURA_SEM_FIO} />
      <span class="encerramento__fio" style={`top: ${pct(F.centro)}; height: ${pct(F.espessura)};`} />
    </div>
    <p class="encerramento__credito">Site feito com Colo, da CalmDev.</p>
  </div>
</div>

<style>
  /* A folha da página passa por cima da faixa. Fundo osso de verdade, não
     transparente: sem ele, a faixa verde apareceria através de toda a
     página, presa ao pé da janela. */
  :global(.pagina) {
    position: relative;
    z-index: 1;
    background: var(--color-osso);
  }

  .encerramento {
    --altura-encerramento: clamp(340px, 72svh, 680px);

    position: sticky;
    bottom: 0;
    z-index: 0;
    height: var(--altura-encerramento);
    display: grid;
    align-content: center;
    padding-inline: var(--spacing-margem);
    background: var(--color-eucalipto);
    color: var(--color-osso);
    /* O fio vai além da janela; aqui ele é aparado, sem barra lateral. */
    overflow: clip;
  }

  .encerramento__marca {
    position: relative;
    width: min(76vw, 1100px);
    aspect-ratio: var(--proporcao);
    transform-origin: 0 100%;
  }

  .encerramento__palavra :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* O fio começa um nada dentro do ponto, para não sobrar fresta, e corre
     até muito além da janela — o `overflow: clip` da faixa apara. */
  .encerramento__fio {
    position: absolute;
    left: calc(100% - 2px);
    width: 100vw;
    translate: 0 -50%;
    background: currentColor;
    transform-origin: 0 50%;
  }

  .encerramento__credito {
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
    font-size: var(--text-rotulo);
    color: var(--color-osso-suave);
  }

  /* --- presa à rolagem ----------------------------------------------------
     `scroll(root)`: a rolagem da página inteira. O trecho começa quando
     falta uma altura de faixa para o fim — o instante em que a folha começa
     a descobri-la — e termina no fim. Cada peça ocupa uma fatia desse
     trecho, em frações da altura da faixa (`--h`). */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .encerramento__marca,
      .encerramento__palavra :global(path),
      .encerramento__palavra :global(circle),
      .encerramento__fio,
      .encerramento__credito {
        /* Propriedades separadas, NUNCA o atalho `animation:` junto com
           `animation-timeline` — ver o aviso em ComoAtendemos.astro. */
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
      }

      /* A marca inteira sobe um pouco e cresce enquanto é descoberta: ela
         vem de mais longe que a folha, e isso dá a profundidade. */
      .encerramento__marca {
        animation-name: encerra-chega;
        animation-range: calc(100% - var(--altura-encerramento)) 100%;
      }

      /* As letras sobem por baixo da borda do SVG, uma depois da outra. O
         deslocamento é em unidades do desenho: 700 passa da altura dele. */
      .encerramento__palavra :global(path) {
        animation-name: encerra-letra;
      }
      .encerramento__palavra :global(path:nth-of-type(1)) {
        animation-range: calc(100% - var(--altura-encerramento)) calc(100% - var(--altura-encerramento) * 0.45);
      }
      .encerramento__palavra :global(path:nth-of-type(2)) {
        animation-range: calc(100% - var(--altura-encerramento) * 0.9) calc(100% - var(--altura-encerramento) * 0.35);
      }
      .encerramento__palavra :global(path:nth-of-type(3)) {
        animation-range: calc(100% - var(--altura-encerramento) * 0.8) calc(100% - var(--altura-encerramento) * 0.25);
      }

      .encerramento__palavra :global(circle) {
        animation-name: encerra-ponto;
        animation-range: calc(100% - var(--altura-encerramento) * 0.45) calc(100% - var(--altura-encerramento) * 0.2);
        transform-box: fill-box;
        transform-origin: center;
      }

      .encerramento__fio {
        animation-name: encerra-fio;
        animation-range: calc(100% - var(--altura-encerramento) * 0.3) calc(100% - 1px);
      }

      .encerramento__credito {
        animation-name: encerra-credito;
        animation-range: calc(100% - var(--altura-encerramento) * 0.25) calc(100% - 1px);
      }
    }
  }

  /* Sem movimento, a faixa é só o último bloco da página. */
  @media (prefers-reduced-motion: reduce) {
    .encerramento {
      position: relative;
    }
  }

  @keyframes encerra-chega {
    from {
      transform: translateY(18%) scale(0.9);
    }
    to {
      transform: none;
    }
  }

  @keyframes encerra-letra {
    from {
      translate: 0 700px;
    }
    to {
      translate: 0 0;
    }
  }

  @keyframes encerra-ponto {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }

  @keyframes encerra-fio {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }

  @keyframes encerra-credito {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
