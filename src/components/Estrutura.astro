---
import { Picture } from 'astro:assets';
import { ESTRUTURA } from '../data/conteudo';
import { imagemFlow } from '../data/imagens';

const { cadeia, sala } = ESTRUTURA;
const total = cadeia.etapas.length;

/*
  Cada prancha encolhe guiada pela linha do tempo da PRANCHA SEGUINTE: ela
  recua no exato trecho de rolagem em que a próxima sobe e a cobre. Para uma
  irmã enxergar a linha do tempo da outra, o nome precisa ser declarado no
  pai (`timeline-scope`). Os nomes saem daqui para não ficarem fixos no CSS:
  a cadeia pode ganhar ou perder uma etapa sem mexer no estilo.
*/
const nome = (i: number) => `--folha-${i}`;
const escopo = cadeia.etapas.map((_, i) => nome(i)).join(', ');
---

{/*
  SEÇÃO 6 — vence "é limpo? é seguro?"

  Duas partes:

    a sala vazia responde o TÍTULO ao pé da letra — "onde você vai sentar"
    é a cadeira desocupada;

    a CADEIA DA ESTERILIZAÇÃO mostra o que antes era um parágrafo de
    promessa: cinco pranchas, uma por etapa, que grudam no topo e se
    empilham conforme a pessoa rola. A borda de cada prancha anterior fica
    visível em cima da seguinte, com o número — a pilha mostra quantas
    etapas o instrumento já passou. Numeração legítima: é sequência real
    (item 13 da seção 9 do BRIEF).

  Não são cards: largura da grade, raio 0, sem sombra, fundo osso com fio de
  1px em cima. A prancha de trás só recua.

  Sem movimento (reduced-motion), ou em tela baixa demais para a pilha
  caber, as cinco viram uma lista comum. Nada fica escondido.

  CFO-196: mostrar estrutura física é permitido; procedimento em andamento e
  equipamento como apelo comercial, não. Nenhuma cena tem paciente ou boca, e
  a autoclave aparece para explicar a etapa, sem marca nem painel.
*/}
<section class="estrutura mt-r-medio" aria-labelledby="estrutura-titulo">
  <div class="grade estrutura__topo">
    <div class="estrutura__titulo">
      <h2 id="estrutura-titulo" class="text-secao">{ESTRUTURA.titulo}</h2>
    </div>

    <div class="estrutura__sala">
      {
        sala ? (
          <video
            data-video
            poster={`/video/${sala}-poster.webp`}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
          >
            <source src={`/video/${sala}.webm`} type="video/webm" />
            <source src={`/video/${sala}.mp4`} type="video/mp4" />
          </video>
        ) : (
          <p class="estrutura__vazio">[PREENCHER vídeo ou foto real da sala de atendimento]</p>
        )
      }
    </div>

    <div class="estrutura__cabeca">
      <h3 id="cadeia-titulo" class="estrutura__subtitulo">{cadeia.titulo}</h3>
      <p class="max-w-corpo mt-4">{cadeia.intro}</p>
    </div>
  </div>

  <ol
    class="pilha"
    aria-labelledby="cadeia-titulo"
    style={`--n: ${total}; --escopo: ${escopo};`}
  >
    {
      cadeia.etapas.map((etapa, i) => (
        <li
          class="pilha__item"
          style={`--i: ${i}; --nome: ${nome(i)}; --guia: ${i < total - 1 ? nome(i + 1) : 'none'};`}
        >
          <div class="pilha__folha">
            <div class="pilha__aba">
              <span class="pilha__numero" data-numero aria-hidden="true">
                {i + 1}
              </span>
              <h4 class="pilha__titulo">{etapa.titulo}</h4>
            </div>

            <p class="pilha__texto">{etapa.texto}</p>

            <div class="pilha__midia">
              {'imagem' in etapa && etapa.imagem ? (
                <Picture
                  src={imagemFlow(etapa.imagem)}
                  alt={etapa.alt}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 900px) 56vw, calc(100vw - 40px)"
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                />
              ) : 'video' in etapa && etapa.video ? (
                <video
                  data-video
                  poster={`/video/${etapa.video}-poster.webp`}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <source src={`/video/${etapa.video}.webm`} type="video/webm" />
                  <source src={`/video/${etapa.video}.mp4`} type="video/mp4" />
                </video>
              ) : (
                <p class="estrutura__vazio">
                  [PREENCHER foto real da clínica: {etapa.titulo.toLowerCase()}]
                </p>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* --- topo: título, sala e a cabeça da cadeia ------------------------
     A ORDEM NO HTML é a ordem de leitura do celular: título, sala, cadeia.
     No desktop a sala ocupa a esquerda e as duas cabeças dividem a direita,
     uma no alto e outra embaixo. Antes o título flutuava sozinho à direita
     com ~400px de vazio em volta — visto no screenshot de 1440. */
  .estrutura__titulo,
  .estrutura__sala,
  .estrutura__cabeca {
    grid-column: 1 / -1;
  }

  .estrutura__sala {
    margin-top: 1.5rem;
  }

  .estrutura__cabeca {
    margin-top: 2.5rem;
  }

  .estrutura__sala video {
    width: 100%;
    height: clamp(220px, 40vh, 420px);
    object-fit: cover;
  }

  .estrutura__subtitulo {
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .estrutura__sala {
      grid-column: 1 / span 7;
      grid-row: 1 / span 2;
      margin-top: 0;
    }

    .estrutura__titulo {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: start;
    }

    .estrutura__cabeca {
      grid-column: 9 / -1;
      grid-row: 2;
      align-self: end;
      margin-top: 2rem;
    }
  }

  /* Só aparece no modo cliente, até a clínica mandar a foto dela. */
  .estrutura__vazio {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 1.5rem;
    border: 1px solid var(--color-linha);
    text-align: center;
  }

  /* --- a pilha ---------------------------------------------------------
     Flex em coluna, não grid, e isto não é detalhe: o bloco que contém um
     item de grid é a área dele na grade, então `sticky` dentro de grid só
     gruda dentro da própria linha — que tem a altura do próprio item. Em
     flex, o bloco que contém é a lista inteira, e as cinco grudam juntas. */
  .pilha {
    --degrau: 3rem;
    --topo: 0.75rem;

    list-style: none;
    margin: clamp(3rem, 7vw, 5.5rem) 0 0;
    padding: 0 var(--spacing-margem);
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .pilha__folha {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--spacing-gutter);
    padding-bottom: 2rem;
    background: var(--color-osso);
    border-top: 1px solid var(--color-linha);
    transform-origin: 50% 0;
  }

  /* A aba tem exatamente a altura do degrau: é a faixa que continua
     visível quando a prancha seguinte sobe por cima. */
  .pilha__aba {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: var(--degrau);
  }

  .pilha__numero {
    flex: none;
    width: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--text-tratamento);
    font-weight: 500;
  }

  .pilha__titulo {
    margin: 0;
    font-family: var(--font-texto);
    font-size: var(--text-tratamento);
    line-height: var(--text-tratamento--line-height);
    font-weight: 500;
  }

  /* O miolo começa 0,75rem abaixo da aba. Quando a prancha recua, ela
     encolhe para cima e o topo do miolo sobe para dentro da faixa que fica
     visível; sem essa folga, uma tira de 4px da foto aparecia embaixo de
     cada aba. */
  .pilha__texto {
    grid-column: 1 / -1;
    max-width: 46ch;
    margin: 0.75rem 0 1.25rem;
  }

  .pilha__midia {
    grid-column: 1 / -1;
    overflow: hidden;
  }

  .pilha__midia :global(img),
  .pilha__midia video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .pilha {
      --degrau: 3.5rem;
      --topo: 1.5rem;
    }

    .pilha__texto {
      grid-column: 1 / span 4;
      grid-row: 2;
      margin: 0.75rem 0 0;
    }

    .pilha__midia {
      grid-column: 6 / -1;
      grid-row: 2;
      margin-top: 0.75rem;
    }
  }

  /* --- empilhar ----------------------------------------------------------
     `sticky` não é animação, mas é movimento: a página deixa de rolar
     igual. Por isso só existe com movimento permitido, e só em tela alta o
     bastante para a última prancha caber debaixo das quatro abas. Em
     700px de altura um iPhone SE ainda fica de fora — lá é lista. */
  @media (prefers-reduced-motion: no-preference) and (min-height: 700px) {
    .pilha {
      --folga: 12vh;
      gap: 0;
    }

    .pilha__item {
      position: sticky;
      top: calc(var(--topo) + var(--i) * var(--degrau));

      /* A SAÍDA DA PILHA. Uma prancha grudada se solta quando o fim da
         lista alcança a margem de baixo dela. Com a mesma margem em todas,
         a última — que gruda mais embaixo — soltava primeiro, subia, e
         deixava à mostra o miolo da anterior, que ainda estava presa:
         um pedaço da foto da autoclave sobrando embaixo da prancha 5. Visto
         no quadro de saída, em 1440 e em 390.

         A margem diminui um degrau por prancha, na mesma conta do `top`:
         topo + margem fica igual para todas, e a pilha sai inteira, junta.
         De quebra, a margem é a folga de leitura entre uma prancha e a
         seguinte, e a última ganha `--folga` de tempo parada.

         Margem e não padding na lista: o limite do sticky é a caixa de
         conteúdo do pai, e padding fica fora dela. */
      margin-bottom: calc(var(--folga) + (var(--n) - 1 - var(--i)) * var(--degrau));
    }

    /* ALTURA IGUAL NO CELULAR. A saída junta da pilha (a margem que diminui
       um degrau por prancha) só funciona se as pranchas tiverem a mesma
       altura. No desktop a foto manda e elas têm. No celular o texto vem
       antes da foto e a altura dele varia — e as pranchas soltavam em
       momentos diferentes: o miolo da anterior aparecia por cima da
       seguinte e a aba "3 Embalagem" ficava cortada ao meio. Visto em 390px.
       Seis linhas cabem o texto mais longo até em 320px; com todas
       reservando o mesmo espaço, todas têm a mesma altura. */
    @media (max-width: 899px) {
      .pilha__texto {
        min-height: 6lh;
      }
    }

    /* Em notebook de 768px de altura a imagem empurraria o fim da última
       prancha para baixo da borda. O teto é o que sobra da janela depois
       das quatro abas, da aba própria e da folga de baixo. */
    .pilha__midia :global(img),
    .pilha__midia video {
      max-height: calc(100svh - var(--topo) - var(--n) * var(--degrau) - 3rem);
    }
  }

  /* --- recuar ------------------------------------------------------------
     A prancha de trás recua enquanto a seguinte sobe — presa à rolagem, não
     disparada por ela. O trecho é exato: começa quando a seguinte entra
     pela borda de baixo (`cover 0%`) e termina quando ela gruda, depois de
     percorrer a janela menos o próprio topo.

     As de trás terminam menores que as da frente, e é isso que faz a pilha
     ler como pilha. Só `scale`, que é propriedade separada de `transform` e
     roda no compositor.

     Fora do Chrome, Edge, Samsung Internet e Safari 26+, a pilha empilha
     sem recuar. Nada some. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-height: 700px) {
      .pilha {
        timeline-scope: var(--escopo);
      }

      .pilha__item {
        view-timeline-name: var(--nome);
        view-timeline-axis: block;
      }

      .pilha__folha {
        /* Propriedades separadas, não o atalho `animation:` — ver o aviso
           em ComoAtendemos.astro. Aqui o `var()` já impedia a junção, mas
           a regra vale para o arquivo inteiro. */
        animation-name: recuar;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: var(--guia);
        animation-range: cover 0%
          cover calc(100vh - var(--topo) - (var(--i) + 1) * var(--degrau));
      }
    }
  }

  @keyframes recuar {
    to {
      scale: calc(0.98 - (var(--n) - var(--i) - 1) * 0.012);
    }
  }
</style>
