---
import { ESTRUTURA } from '../data/conteudo';
---

{/*
  SEÇÃO 6 — vence "é limpo? é seguro?"

  Dois vídeos, porque a seção diz duas coisas diferentes e antes tinha
  imagem para nenhuma delas:

    a sala vazia responde o TÍTULO ao pé da letra — "onde você vai sentar"
    é a cadeira desocupada;

    a embalagem selada sendo aberta responde o PARÁGRAFO DE ESTERILIZAÇÃO,
    que descreve exatamente essa cena.

  A ORDEM NO HTML é a ordem de leitura do celular: título, sala, texto,
  embalagem. No desktop a grade reposiciona em duas fileiras lado a lado.
  Antes o HTML seguia a ordem do desktop, e empilhado no celular o título
  ficava ensanduichado entre os dois vídeos — vídeo, título, vídeo, texto.

  CFO-196: mostrar estrutura física é permitido. O que a resolução proíbe é
  procedimento em andamento e equipamento como apelo comercial — a sala está
  vazia e nenhuma das duas cenas tem paciente ou boca.
*/}
<section class="estrutura grade mt-r-medio" aria-labelledby="estrutura-titulo">
  <div class="estrutura__titulo">
    <h2 id="estrutura-titulo" class="text-secao">{ESTRUTURA.titulo}</h2>
  </div>

  <div class="estrutura__sala">
    <video
      data-video
      poster="/video/sala-vazia-poster.webp"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/video/sala-vazia.webm" type="video/webm" />
      <source src="/video/sala-vazia.mp4" type="video/mp4" />
    </video>
  </div>

  <div class="estrutura__texto">
    <div class="max-w-prancha grid gap-4">
      {ESTRUTURA.paragrafos.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <div class="estrutura__selado">
    <video
      data-video
      poster="/video/instrumental-selado-poster.webp"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/video/instrumental-selado.webm" type="video/webm" />
      <source src="/video/instrumental-selado.mp4" type="video/mp4" />
    </video>
  </div>
</section>

<style>
  /* --- celular: empilha na ordem do HTML --------------------------- */
  .estrutura__titulo,
  .estrutura__sala,
  .estrutura__texto,
  .estrutura__selado {
    grid-column: 1 / -1;
  }

  .estrutura__sala {
    margin-top: 1.5rem;
  }

  .estrutura__texto {
    margin-top: 2rem;
  }

  .estrutura__selado {
    margin-top: 2rem;
  }

  .estrutura video {
    width: 100%;
    object-fit: cover;
  }

  .estrutura__sala video {
    height: clamp(220px, 40vh, 420px);
  }

  .estrutura__selado video {
    height: clamp(200px, 30vh, 300px);
  }

  /* --- desktop: duas fileiras, desalinhadas de propósito ------------ */
  @media (min-width: 768px) {
    .estrutura__sala {
      grid-column: 1 / span 7;
      grid-row: 1;
      margin-top: 0;
    }

    .estrutura__titulo {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: center;
    }

    /* A segunda fileira não repete o alinhamento da primeira: a seção não é
       uma grade de dois cards iguais. */
    .estrutura__selado {
      grid-column: 3 / span 4;
      grid-row: 2;
      margin-top: 6rem;
    }

    .estrutura__texto {
      grid-column: 8 / -1;
      grid-row: 2;
      align-self: center;
      margin-top: 6rem;
    }
  }
</style>
